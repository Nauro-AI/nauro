{
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "The complete replacement stack.md document; stored byte-exact with no normalization."
    },
    "expected_revision": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "absent"
          ]
        },
        {
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      ],
      "description": "Required for generation stack submission. Use the stack_revision from an authorized get_raw_file(\"stack.md\") read; use absent only when that read found no stack.md. Retry preserves the original revision. Optional on legacy projects, and enforced when supplied."
    },
    "operation_id": {
      "type": "string",
      "description": "Legacy projects: required client-generated idempotency identifier (1-128 printable ASCII characters); resending it with the same payload returns the original outcome. Selected generation projects: omit it on submission, because the server issues the identity and refuses a caller-supplied one; pass the server-issued stack-request identity only to recover or retry."
    },
    "project_id": {
      "type": "string",
      "description": "Optional; auto-resolved for one project. With several, list ids via list_projects (hosted) or `nauro projects` (local)."
    },
    "request_mode": {
      "type": "string",
      "enum": [
        "submit",
        "recover",
        "retry",
        "discover"
      ]
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "after": {
      "type": "string",
      "maxLength": 256
    }
  },
  "oneOf": [
    {
      "required": [
        "request_mode",
        "content",
        "expected_revision"
      ],
      "propertyNames": {
        "enum": [
          "project_id",
          "request_mode",
          "content",
          "expected_revision"
        ]
      },
      "properties": {
        "request_mode": {
          "const": "submit"
        }
      }
    },
    {
      "required": [
        "content",
        "expected_revision"
      ],
      "propertyNames": {
        "enum": [
          "project_id",
          "content",
          "expected_revision"
        ]
      }
    },
    {
      "required": [
        "request_mode",
        "project_id",
        "operation_id",
        "payload_digest"
      ],
      "propertyNames": {
        "enum": [
          "project_id",
          "request_mode",
          "operation_id",
          "payload_digest"
        ]
      },
      "properties": {
        "request_mode": {
          "const": "recover"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^stack-request:[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "minLength": 40,
          "maxLength": 40
        }
      }
    },
    {
      "required": [
        "request_mode",
        "project_id",
        "operation_id",
        "payload_digest"
      ],
      "propertyNames": {
        "enum": [
          "project_id",
          "request_mode",
          "operation_id",
          "payload_digest"
        ]
      },
      "properties": {
        "request_mode": {
          "const": "retry"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^stack-request:[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "minLength": 40,
          "maxLength": 40
        }
      }
    },
    {
      "required": [
        "request_mode",
        "project_id"
      ],
      "propertyNames": {
        "enum": [
          "project_id",
          "request_mode",
          "after"
        ]
      },
      "properties": {
        "request_mode": {
          "const": "discover"
        }
      }
    },
    {
      "required": [
        "content",
        "operation_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "after"
            ]
          },
          {
            "required": [
              "payload_digest"
            ]
          },
          {
            "required": [
              "request_mode"
            ]
          }
        ]
      }
    }
  ]
}
